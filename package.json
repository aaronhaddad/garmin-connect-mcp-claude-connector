{
  "name": "garmin-personal-api-mcp",
  "version": "0.1.0",
  "description": "MCP server for your own Garmin Connect data (activities with FIT splits, sleep, HRV, Body Battery, weight) via Garmin's official Personal API, with an interactive key setup wizard.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "npm run build && node dist/index.js setup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build",
    "check": "tsc --noEmit && vitest run && npm run smoke"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "garmin",
    "garmin-connect",
    "fit",
    "running",
    "claude",
    "health"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@garmin/fitsdk": "^21.218.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "fflate": "^0.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "bin": {
    "garmin-personal-api-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/garmin-personal-api-mcp.git"
  },
  "author": "Haroun (Aaron) Haddad"
}
